generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  EDITOR
  ADMIN
}

enum WorkType {
  BOOK
  MOVIE
}

enum ReadingStatus {
  READ
  READING
  WANT_TO_READ
}

enum ActivityType {
  RATING
  REVIEW
  COLLECTION
  STATUS
  FOLLOW
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  displayName String?
  email     String   @unique
  password  String
  role      Role     @default(READER)
  createdAt DateTime @default(now())

  ratings     Rating[]
  reviews     Review[]
  statuses    UserWorkStatus[]
  collections Collection[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  activities Activity[]
}

model Author {
  id        Int     @id @default(autoincrement())
  name      String
  biography String?
  birthYear Int?

  works WorkAuthor[]
}

model Genre {
  id   Int    @id @default(autoincrement())
  name String @unique

  works WorkGenre[]
}

model Work {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  type          WorkType
  releaseYear   Int?
  poster        String?
  averageRating Float    @default(0)
  ratingCount   Int      @default(0)
  popularity    Int      @default(0)
  createdAt     DateTime @default(now())

  authors     WorkAuthor[]
  genres      WorkGenre[]
  ratings     Rating[]
  reviews     Review[]
  statuses    UserWorkStatus[]
  collections CollectionWork[]
  activities  Activity[]

  @@index([averageRating])
  @@index([releaseYear])
  @@index([type])
  @@index([popularity])
}

model WorkAuthor {
  workId   Int
  authorId Int

  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([workId, authorId])
}

model WorkGenre {
  workId  Int
  genreId Int

  work  Work  @relation(fields: [workId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([workId, genreId])
  @@index([genreId, workId])
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  workId    Int
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([workId])
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  workId     Int
  text       String   @db.Text
  hasSpoilers Boolean @default(false)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, createdAt])
  @@index([userId])
}

model UserWorkStatus {
  id        Int           @id @default(autoincrement())
  userId    Int
  workId    Int
  status    ReadingStatus
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model Collection {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  works CollectionWork[]
}

model CollectionWork {
  collectionId Int
  workId       Int
  position     Int

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  work       Work       @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([collectionId, workId])
  @@unique([collectionId, position])
}

model Follow {
  followerId  Int
  followedId  Int
  createdAt   DateTime @default(now())

  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("UserFollowers", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
}

model Activity {
  id          Int          @id @default(autoincrement())
  userId      Int
  workId      Int?
  type        ActivityType
  description String?
  createdAt   DateTime     @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work? @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
